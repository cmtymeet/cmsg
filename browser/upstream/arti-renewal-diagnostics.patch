+#[cfg(test)]
+mod fixture_renewal_tests {
+    use super::*;
+
+    #[test]
+    fn fixture_publication_is_per_service_and_late_batches_do_not_fake_transition() {
+        let first = StatusSender::new(OnionServiceStatus::new_shutdown());
+        let second = StatusSender::new(OnionServiceStatus::new_shutdown());
+        let publisher = PublisherStatusSender::from(first.clone());
+        publisher.fixture_note_current_period(10);
+        publisher.fixture_note_publication(11);
+        let baseline = first.get().fixture_publication_snapshot();
+        assert_eq!(baseline, (1, Some(11), Some(10)));
+        let transitioned = |snapshot: (u32, Option<u64>, Option<u64>)| {
+            snapshot.0 > baseline.0 && snapshot.1 > baseline.1 && snapshot.2 > baseline.2
+        };
+
+        publisher.fixture_note_publication(10); // delayed initial/older batch
+        assert_eq!(first.get().fixture_publication_snapshot(), (2, Some(11), Some(10)));
+        assert!(!transitioned(first.get().fixture_publication_snapshot()));
+        publisher.fixture_note_publication(12); // future publication alone is insufficient
+        assert!(!transitioned(first.get().fixture_publication_snapshot()));
+        publisher.fixture_note_current_period(11);
+        assert!(transitioned(first.get().fixture_publication_snapshot()));
+        assert_eq!(second.get().fixture_publication_snapshot(), (0, None, None));
+    }
+}
