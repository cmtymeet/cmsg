 #[cfg(feature = "hs-pow-full")]
 impl_status_sender!(PowManagerStatusSender, pow_manager);
 
+impl PublisherStatusSender {
+    /// Record the current period from this reactor's authenticated directory.
+    pub(crate) fn fixture_note_current_period(&self, period: u64) {
+        let mut tx = self.0.0.lock().expect("Poisoned lock");
+        let mut status = tx.borrow().clone();
+        status.fixture_current_period = Some(period);
+        tx.maybe_send(|_| status);
+    }
+
+    /// Record an accepted completed batch with at least one successful upload.
+    /// A late older batch may increase the count, but never the latest period.
+    pub(crate) fn fixture_note_publication(&self, period: u64) {
+        let mut tx = self.0.0.lock().expect("Poisoned lock");
+        let mut status = tx.borrow().clone();
+        status.fixture_successful_batches = status.fixture_successful_batches.saturating_add(1);
+        status.fixture_latest_successful_period = Some(
+            status.fixture_latest_successful_period.map_or(period, |old| old.max(period)));
+        tx.maybe_send(|_| status);
+    }
+}
