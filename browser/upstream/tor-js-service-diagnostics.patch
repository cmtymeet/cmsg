 use wasm_bindgen::prelude::*;
 
 fn failure() -> JsValue { JsValue::from_str("tor-js:OnionService") }
+
+// Only applied to explicit diagnostic source builds. All labels are static;
+// no error payloads, addresses, key values or filesystem paths are formatted.
+fn stage_failure(stage: &'static str) -> JsValue {
+    JsValue::from_str(&format!("tor-js:OnionService:{stage}"))
+}
+fn launch_failure(error: &arti_client::Error) -> JsValue {
+    let mut cause: Option<&(dyn std::error::Error + 'static)> = Some(error);
+    for _ in 0..8 {
+        let Some(error) = cause else { break; };
+        if let Some(startup) = error.downcast_ref::<tor_hsservice::StartupError>() {
+            use tor_hsservice::StartupError as E;
+            return stage_failure(match startup {
+                E::Keystore { .. } => "launch-keystore",
+                E::KeystoreCorrupted => "launch-keystore-corrupt",
+                E::LoadState(_) => "launch-load-state",
+                E::StateDirectoryInaccessible(_) => "launch-state-directory",
+                E::StateDirectoryInaccessibleIo { .. } => "launch-state-io",
+                E::Fatal(_) => "launch-fatal",
+                E::Spawn { .. } => "launch-spawn",
+                E::AlreadyLaunched => "launch-already-started",
+                _ => "launch-other",
+            });
+        }
+        cause = error.source();
+    }
+    stage_failure("launch-client")
+}
+fn readiness_failure(service: &BrowserOnionService, stage: &'static str) -> JsValue {
+    let running = service.state.service.borrow();
+    let Some(running) = running.as_ref() else { return stage_failure("missing-running-service"); };
+    let labels = running.status().fixture_status_labels();
+    JsValue::from_str(&format!(
+        "tor-js:OnionService:{stage}:ipt={}/{}:publisher={}/{}:last-ipt={}/{}",
+        labels[0], labels[1], labels[2], labels[3], labels[4], labels[5]
+    ))
+}
 fn integer(value: f64, maximum: u32) -> Result<u32, JsValue> {
     if !value.is_finite() || value.fract() != 0.0 || value < 1.0 || value > f64::from(maximum) {
