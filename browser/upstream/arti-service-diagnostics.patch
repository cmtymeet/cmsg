+// Isolated test-network diagnostic only: retain two static labels for the
+// latest IPT failure across this runtime, never error payloads or relay details.
+static FIXTURE_LAST_IPT_ERROR: Mutex<Option<(&'static str, &'static str)>> = Mutex::new(None);
+
+pub(crate) fn fixture_last_ipt_error() -> Option<(&'static str, &'static str)> {
+    *FIXTURE_LAST_IPT_ERROR.lock().expect("poisoned fixture diagnostic")
+}
+
+fn fixture_note_ipt_error(err: &IptEstablisherError) {
+    use IptEstablisherError as E;
+    use tor_error::ErrorKind as K;
+    let stage = match err {
+        E::Ipt(_) => "ipt",
+        E::NetdirProviderShutdown(_) => "netdir-shutdown",
+        E::BuildCircuit(_) => "build-circuit",
+        E::CircuitState(_) => "circuit-state",
+        E::CreateEstablishIntro(_) => "create-establish",
+        E::EstablishTimeout => "establish-timeout",
+        E::SendEstablishIntro(_) => "send-establish",
+        E::ClosedWithoutAck => "closed-without-ack",
+        E::Bug(_) => "bug",
+    };
+    let kind = match tor_error::HasKind::kind(err) {
+        K::TorAccessFailed => "tor-access",
+        K::BootstrapRequired => "bootstrap-required",
+        K::DirectoryExpired => "directory-expired",
+        K::LocalNetworkError => "local-network",
+        K::LocalResourceExhausted => "local-resource",
+        K::RelayIdMismatch => "relay-id-mismatch",
+        K::CircuitCollapse => "circuit-collapse",
+        K::TorNetworkTimeout => "tor-network-timeout",
+        K::TorDirectoryError => "tor-directory",
+        K::RelayTooBusy => "relay-busy",
+        K::CircuitRefused => "circuit-refused",
+        K::NoPath => "no-path",
+        K::TorDirectoryUnusable => "directory-unusable",
+        K::ClockSkew => "clock-skew",
+        K::TorProtocolViolation => "tor-protocol",
+        K::RemoteProtocolViolation => "remote-protocol",
+        K::Internal => "internal",
+        _ => "other",
+    };
+    *FIXTURE_LAST_IPT_ERROR.lock().expect("poisoned fixture diagnostic") = Some((stage, kind));
+}
 
