 //! Support for reporting the status of an onion service.
 
 use crate::internal_prelude::*;
+
+// Applied only to the isolated test-network build. These are runtime-wide last
+// observations across concurrent uploads, not a per-service event history.
+// Retain static categories only: no addresses, identities, paths or payloads.
+static FIXTURE_PUBLISHER: std::sync::Mutex<[&'static str; 5]> =
+    std::sync::Mutex::new(["none"; 5]);
+
+pub(crate) fn fixture_publisher_note(index: usize, value: &'static str) {
+    FIXTURE_PUBLISHER.lock().expect("poisoned fixture diagnostic")[index] = value;
+}
+
+pub(crate) fn fixture_publisher_error(stage: &'static str, error: tor_error::ErrorKind) {
+    use tor_error::ErrorKind as K;
+    let kind = match error {
+        K::TorAccessFailed => "tor-access",
+        K::BootstrapRequired => "bootstrap-required",
+        K::DirectoryExpired => "directory-expired",
+        K::LocalNetworkError => "local-network",
+        K::LocalResourceExhausted => "local-resource",
+        K::RelayIdMismatch => "relay-id-mismatch",
+        K::CircuitCollapse => "circuit-collapse",
+        K::TorNetworkTimeout => "tor-network-timeout",
+        K::TorDirectoryError => "tor-directory",
+        K::RelayTooBusy => "relay-busy",
+        K::CircuitRefused => "circuit-refused",
+        K::NoPath => "no-path",
+        K::TorDirectoryUnusable => "directory-unusable",
+        K::ClockSkew => "clock-skew",
+        K::TorProtocolViolation => "tor-protocol",
+        K::RemoteProtocolViolation => "remote-protocol",
+        K::Internal => "internal",
+        _ => "other",
+    };
+    let mut labels = FIXTURE_PUBLISHER.lock().expect("poisoned fixture diagnostic");
+    labels[3] = stage;
+    labels[4] = kind;
+}
+
+impl OnionServiceStatus {
+    /// Isolated fixture categories: scheduling, period count, last upload step,
+    /// and latest per-attempt error stage/kind across this runtime.
+    #[doc(hidden)]
+    pub fn fixture_publisher_labels(&self) -> [&'static str; 5] {
+        *FIXTURE_PUBLISHER.lock().expect("poisoned fixture diagnostic")
+    }
+}
 
