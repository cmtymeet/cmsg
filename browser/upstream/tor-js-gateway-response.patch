+      assert.equal(conn.streams[0].state.closed, true)
+    } finally { clearTimeout(keepAlive); gw.close() }
+  })
+
+  test('an aborted open rejects promptly and disposes a late stream', { timeout: 1000 }, async () => {
+    const conn = makeConn([{ pieces: [OK], endAfterPieces: false }])
+    const open = conn.openStream.bind(conn)
+    conn.openStream = async options => { await tick(40); return open(options) }
+    const gw = new KpsGateway(ADDR, { dial: makeDial({ conn }) })
+    const controller = new AbortController()
+    const timer = setTimeout(() => controller.abort(), 10)
+    try {
+      await assert.rejects(gw.connect('127.0.0.1:12345', { signal: controller.signal }),
+        /CONNECT stream: timed out/)
+      await tick(60)
+      assert.equal(conn.streams[0].state.closed, true)
+    } finally { clearTimeout(timer); gw.close() }
+  })
