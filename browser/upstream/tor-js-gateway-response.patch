+describe('bounded CONNECT refusal parsing', () => {
+  test('Content-Length refusal completes on a keep-alive stream', { timeout: 1000 }, async () => {
+    const body = 'target is not an advertised Tor relay'
+    const conn = makeConn([{ pieces: [
+      `HTTP/1.1 403 Forbidden\r\nContent-Length: ${enc.encode(body).length}\r\n\r\n`, body,
+    ], endAfterPieces: false }])
+    const gw = new KpsGateway(ADDR, { dial: makeDial({ conn }) })
+    await assert.rejects(gw.connect('127.0.0.1:12345'),
+      /^Error: CONNECT 127\.0\.0\.1:12345: 403 target is not an advertised Tor relay$/)
+    assert.equal(conn.streams[0].state.closed, true)
+    assert.equal(conn.streams[0].readable.locked, false)
+    assert.equal(conn.streams[0].writable.locked, false)
+    gw.close()
+  })
+
+  test('zero-length refusal needs no EOF', { timeout: 1000 }, async () => {
+    const conn = makeConn([{ pieces: ['HTTP/1.1 403 Forbidden\r\nContent-Length: 0\r\n\r\n'],
+      endAfterPieces: false }])
+    const gw = new KpsGateway(ADDR, { dial: makeDial({ conn }) })
+    await assert.rejects(gw.connect('127.0.0.1:12345'), /403 Forbidden/)
+    assert.equal(conn.streams[0].state.closed, true)
+    gw.close()
+  })
+
+  test('ambiguous, oversized and truncated refusal bodies fail closed', async () => {
+    for (const response of [
+      'HTTP/1.1 403 Forbidden\r\nContent-Length: 1\r\nContent-Length: 1\r\n\r\nx',
+      'HTTP/1.1 403 Forbidden\r\nContent-Length: 1,1\r\n\r\nx',
+      'HTTP/1.1 403 Forbidden\r\nContent-Length: 4097\r\n\r\n',
+      'HTTP/1.1 403 Forbidden\r\nContent-Length: 2\r\n\r\nx',
+      'HTTP/1.1 403 Forbidden\r\nContent-Length: 1\r\n\r\nxx',
+      'HTTP/1.1 403 Forbidden\r\nTransfer-Encoding: chunked\r\nContent-Length: 0\r\n\r\n',
+      'HTTP/1.1 403 Forbidden\r\n\r\n' + 'x'.repeat(4097),
+    ]) {
+      const conn = makeConn([{ pieces: [response] }])
+      const gw = new KpsGateway(ADDR, { dial: makeDial({ conn }) })
+      await assert.rejects(gw.connect('127.0.0.1:12345'), /framing|body/)
+      assert.equal(conn.streams[0].state.closed, true)
+      gw.close()
+    }
+  })
+
+  test('the caller abort still applies after the refusal head', { timeout: 1000 }, async () => {
+    const conn = makeConn([{ pieces: ['HTTP/1.1 403 Forbidden\r\nContent-Length: 1\r\n\r\n'],
+      endAfterPieces: false }])
+    const gw = new KpsGateway(ADDR, { dial: makeDial({ conn }) })
+    const controller = new AbortController()
+    const timer = setTimeout(() => controller.abort(), 20)
+    try {
+      await assert.rejects(gw.connect('127.0.0.1:12345', { signal: controller.signal }),
+        /CONNECT error body: timed out/)
+      assert.equal(conn.streams[0].state.closed, true)
+    } finally { clearTimeout(timer); gw.close() }
+  })
+
+  test('response head cap does not discard a large coalesced tunnel body', async () => {
+    const body = 'z'.repeat(100_000)
+    const conn = makeConn([{ pieces: [OK + body] }])
+    const gw = new KpsGateway(ADDR, { dial: makeDial({ conn }) })
+    const socket = await gw.connect('127.0.0.1:12345')
+    assert.equal(dec.decode((await socket.readable.getReader().read()).value), body)
+    socket.close(); gw.close()
+  })
+
+  test('oversized incomplete response heads are rejected', async () => {
+    const conn = makeConn([{ pieces: ['HTTP/1.1 403 Forbidden\r\nX-Large: ' + 'x'.repeat(65536)] }])
+    const gw = new KpsGateway(ADDR, { dial: makeDial({ conn }) })
+    await assert.rejects(gw.connect('127.0.0.1:12345'), /response head too large/)
+    assert.equal(conn.streams[0].state.closed, true)
+    gw.close()
+  })
+})
