+/** Bounded CONNECT refusal body. A known length completes without stream FIN. */
+async function readConnectError(
+  reader: ReadableStreamDefaultReader<Uint8Array>, head: ResponseHead, signal: AbortSignal,
+): Promise<string> {
+  if (head.headers['transfer-encoding'] !== undefined) {
+    throw new Error('unsupported CONNECT error body framing');
+  }
+  const length = head.headers['content-length'];
+  let expected: number | undefined;
+  if (length !== undefined) {
+    if (!/^[0-9]+$/.test(length)) throw new Error('invalid CONNECT error body length');
+    expected = Number(length);
+    if (!Number.isSafeInteger(expected) || expected > MAX_CONNECT_ERROR_BYTES) {
+      throw new Error('CONNECT error body too large');
+    }
+  }
+  const chunks = [head.extra];
+  let size = head.extra.length;
+  const checkSize = () => {
+    if (size > MAX_CONNECT_ERROR_BYTES || (expected !== undefined && size > expected)) {
+      throw new Error('CONNECT error body too large');
+    }
+  };
+  checkSize();
+  while (expected === undefined || size < expected) {
+    const { done, value } = await abortRace(reader.read(), signal, 'CONNECT error body');
+    if (done) {
+      if (expected !== undefined && size !== expected) throw new Error('incomplete CONNECT error body');
+      break;
+    }
+    size += value.length;
+    checkSize();
+    chunks.push(value);
+  }
+  return dec.decode(concat(chunks, size)).trim();
 }
 
