+    /// Exercise the real upload tasks, completion channel and clean-state updates.
+    /// Only the HTTP streams and clock are mocked by the caller's fixture.
+    pub(in crate::publish) async fn check_upload_all_period_ordering<M: Mockable>(
+        reactor: &mut Reactor<tor_rtmock::MockRuntime, M>,
+        runtime: &tor_rtmock::MockRuntime,
+        publish_count: &std::sync::atomic::AtomicUsize,
+        netdir: Arc<NetDir>,
+    ) {
+        use std::sync::atomic::Ordering;
+        use DescriptorStatus::{Clean, Dirty};
+
+        let periods = reactor.compute_time_periods(&netdir, &[]).unwrap();
+        assert_eq!(periods.len(), 2, "fixture needs two distinct SRV periods");
+        assert_ne!(periods[0].params.time_period(), periods[1].params.time_period());
+        assert!(periods.iter().all(|period| !period.hs_dirs.is_empty()));
+        {
+            let mut inner = reactor.inner.lock().unwrap();
+            inner.netdir = Some(netdir);
+            inner.time_periods = periods;
+        }
+
+        // Check both actual period orderings, including no work and all work.
+        // In particular, the first case catches an early return on a clean ring.
+        for _ in 0..2 {
+            for statuses in [[Clean, Dirty], [Dirty, Clean], [Dirty, Dirty], [Clean, Clean]] {
+                let mut expected = vec![];
+                {
+                    let mut inner = reactor.inner.lock().unwrap();
+                    for (period, status) in inner.time_periods.iter_mut().zip(statuses) {
+                        for (_, descriptor_status) in &mut period.hs_dirs {
+                            *descriptor_status = status;
+                        }
+                        if status == Dirty {
+                            expected.push((period.params.time_period(), period.hs_dirs.len()));
+                        }
+                    }
+                }
+                let expected_count: usize = expected.iter().map(|(_, count)| count).sum();
+                let before = publish_count.load(Ordering::SeqCst);
+                // Honor the actual rate limiter rather than resetting its state.
+                runtime.advance_by(UPLOAD_RATE_LIM_THRESHOLD + Duration::from_secs(1)).await;
+                reactor.upload_all().await.unwrap();
+                runtime.progress_until_stalled().await;
+                assert_eq!(
+                    publish_count.load(Ordering::SeqCst) - before,
+                    expected_count,
+                    "dirty period upload was skipped or a clean period was uploaded"
+                );
+
+                // Validate period identity and every HTTP result, not just the
+                // aggregate number of attempts. The production completion handler
+                // must mark exactly these descriptors clean.
+                while let Some(Some(result)) = reactor.upload_task_complete_rx.next().now_or_never() {
+                    let index = expected.iter().position(|(period, _)| *period == result.time_period)
+                        .expect("unexpected or duplicate period upload");
+                    let (_, count) = expected.remove(index);
+                    assert_eq!(result.hsdir_result.len(), count);
+                    assert!(result.hsdir_result.iter().all(|upload| upload.upload_res.is_ok()));
+                    reactor.handle_upload_results(result);
+                }
+                assert!(expected.is_empty(), "missing period completion");
+                assert!(reactor.inner.lock().unwrap().time_periods.iter().all(|period|
+                    period.hs_dirs.iter().all(|(_, status)| *status == Clean)));
+
+                // A second dispatch after completion must not upload any clean
+                // descriptor or produce a completion for an empty task.
+                runtime.advance_by(UPLOAD_RATE_LIM_THRESHOLD + Duration::from_secs(1)).await;
+                reactor.upload_all().await.unwrap();
+                runtime.progress_until_stalled().await;
+                assert_eq!(publish_count.load(Ordering::SeqCst), before + expected_count);
+                assert!(reactor.upload_task_complete_rx.next().now_or_never().is_none());
+            }
+            reactor.inner.lock().unwrap().time_periods.reverse();
+        }
+    }
